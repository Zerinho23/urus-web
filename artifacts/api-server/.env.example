# URL de la base de datos PostgreSQL (Railway provee esto automáticamente)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Tebex
TEBEX_SECRET_KEY=tu_tebex_secret
TEBEX_WEBSTORE_ID=tu_webstore_id

# CORS: dominio(s) del frontend en Vercel (separados por coma si hay varios)
# Ejemplo: https://urus-store.vercel.app,https://panelurus.com
CORS_ORIGIN=https://TU-APP.vercel.app

# Token del bot de Discord (si se usa)
DISCORD_BOT_TOKEN=
