# URL de la base de datos PostgreSQL (Railway provee esto automáticamente)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Tebex
TEBEX_SECRET_KEY=tu_tebex_secret
TEBEX_WEBSTORE_ID=tu_webstore_id
# Secreto de firma de webhooks (Tebex Creator -> Webhooks). Sin esto, los
# eventos de pago entrante se rechazan por seguridad.
TEBEX_WEBHOOK_SECRET=

# Token que debes inventar tú y mandar en el header "x-admin-token" para
# poder usar /api/tebex/packages (lista interna de paquetes). Sin esto, ese
# endpoint queda público.
ADMIN_TOKEN=

# CORS: dominio(s) del frontend en Vercel (separados por coma si hay varios)
# Ejemplo: https://urus-store.vercel.app,https://panelurus.com
CORS_ORIGIN=https://TU-APP.vercel.app

# Token del bot de Discord (si se usa)
DISCORD_BOT_TOKEN=
